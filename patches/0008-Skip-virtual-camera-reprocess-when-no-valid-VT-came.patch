From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Suchit <gtsuchit7x@example.com>
Date: Mon, 24 Aug 2026 00:00:00 +0530
Subject: [PATCH 8/8] Skip virtual camera reprocess when no valid VT camera
 id is set

* device does not expose a virtual/SAT camera device, so
  mBackVtCameraId/mFrontVtCameraId are always "-1"
* VirtualCameraReprocessor.checkConditionIsReady() previously
  proceeded anyway, eventually calling openVTCamera("-1"), which
  throws IllegalArgumentException (unknown device -1) on
  JpegEncoderThread and crashes the whole camera process
* bail out early with the same pattern already used for the
  "processor is busy" / "ignore null request" cases instead
---
 .../camera/imagecodec/impl/VirtualCameraReprocessor.smali    | 29 +++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/smali_classes5/com/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor.smali b/smali_classes5/com/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor.smali
index 0000000..0000000 100644
--- a/smali_classes5/com/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor.smali
+++ b/smali_classes5/com/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor.smali
@@ -455,6 +455,35 @@
     return v2
 
     :cond_1
+    iget-object v0, p0, Lcom/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor;->mBackVtCameraId:Ljava/lang/String;
+
+    const-string v2, "-1"
+
+    invoke-virtual {v2, v0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_vtcam_ready
+
+    iget-object v0, p0, Lcom/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor;->mFrontVtCameraId:Ljava/lang/String;
+
+    invoke-virtual {v2, v0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_vtcam_ready
+
+    sget-object v0, Lcom/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor;->TAG:Ljava/lang/String;
+
+    const-string v2, "checkConditionIsReady: no valid virtual camera id, skipping reprocess"
+
+    invoke-static {v0, v2}, Lcom/xiaomi/engine/Log;->w(Ljava/lang/String;Ljava/lang/String;)I
+
+    const/4 v0, 0x0
+
+    return v0
+
+    :cond_vtcam_ready
     invoke-direct {p0, v1}, Lcom/xiaomi/camera/imagecodec/impl/VirtualCameraReprocessor;->createCaptureSessionIfNeed(Lcom/xiaomi/camera/imagecodec/ReprocessData;)Z
 
     move-result p0
-- 
2.54.0